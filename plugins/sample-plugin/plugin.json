{
  "schemaVersion": 1,
  "id": "sample-ha-readonly",
  "name": "示例：HA 看板",
  "version": "1.0.0",
  "runtime": "js",
  "entry": "main.js",
  "hostMinVersion": "2.0.0",
  "description": "内置示例插件。填入 Home Assistant 的地址与长期令牌，即可把实体列表当作设备显示并可开关。用来验证「安装 → 登录 → 设备上首页 → 控制」整条链路。",
  "author": "miha 内置示例",
  "homepage": "",
  "license": "GPL-3.0-or-later",
  "permissions": ["network", "secureStore", "log"],
  "login": {
    "type": "form"
  },
  "capabilities": {
    "homes": true,
    "devices": true,
    "scenes": false,
    "spec": false,
    "statistics": false,
    "messages": false,
    "consumables": false,
    "lanControl": false,
    "gatewayControl": false
  },
  "update": {
    "source": "none",
    "repo": "",
    "assetPattern": ""
  }
}
